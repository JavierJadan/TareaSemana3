<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="TareaSemana3.Views.vRegistroContacto"
             Title="Nuevo contacto">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="DarkBlue" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Blue" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label
                Text="Registro de contacto"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Image
                Source="https://cdn-icons-png.flaticon.com/512/4239/4239021.png"
                HeightRequest="105"
                Aspect="AspectFit" />

            <Label Text="Tipo de identificación" />
            <Picker
                x:Name="pckIdentificacion"
                Title="Seleccione CI, RUC o Pasaporte"
                SelectedIndexChanged="PckIdentificacion_OnSelectedIndexChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>CI</x:String>
                        <x:String>RUC</x:String>
                        <x:String>Pasaporte</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Número de identificación" />
            <Entry
                x:Name="txtIdentificacion"
                Placeholder="Seleccione primero el tipo" />

            <Label Text="Nombres" />
            <Entry
                x:Name="txtNombres"
                Placeholder="Ingrese los nombres"
                Keyboard="Text" />

            <Label Text="Apellidos" />
            <Entry
                x:Name="txtApellidos"
                Placeholder="Ingrese los apellidos"
                Keyboard="Text" />

            <Label Text="Fecha de nacimiento" />
            <DatePicker
                x:Name="dpFecha"
                MaximumDate="{x:Static sys:DateTime.Today}" />

            <Label Text="Correo" />
            <Entry
                x:Name="txtCorreo"
                Placeholder="ejemplo@correo.com"
                Keyboard="Email" />

            <Label Text="Salario" />
            <Entry
                x:Name="txtSalario"
                Placeholder="Ingrese el salario"
                Keyboard="Numeric" />

            <Button
                Text="Guardar y visualizar"
                Clicked="BtnGuardar_OnClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
