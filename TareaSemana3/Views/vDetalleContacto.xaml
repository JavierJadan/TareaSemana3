<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TareaSemana3.Views.vDetalleContacto"
             Title="Datos del contacto">

    <ContentPage.Resources>
        <Style x:Key="styleTitulo" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="styleDato" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="styleIess" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="Blue" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="styleBoton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Blue" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label
                Text="Contacto registrado"
                Style="{StaticResource styleTitulo}" />

            <Image
                Source="https://cdn1.iconfinder.com/data/icons/currency-254/48/calculator_accounting_money_business_and_finance_electronics-512.png"
                HeightRequest="80"
                Aspect="AspectFit" />

            <Label x:Name="lblTipo" Style="{StaticResource styleDato}" />
            <Label x:Name="lblIdentificacion" Style="{StaticResource styleDato}" />
            <Label x:Name="lblNombres" Style="{StaticResource styleDato}" />
            <Label x:Name="lblApellidos" Style="{StaticResource styleDato}" />
            <Label x:Name="lblFecha" Style="{StaticResource styleDato}" />
            <Label x:Name="lblCorreo" Style="{StaticResource styleDato}" />
            <Label x:Name="lblSalario" Style="{StaticResource styleDato}" />
            <Label x:Name="lblIess" Style="{StaticResource styleIess}" />

            <Button
                Text="Exportar a archivo de texto"
                Style="{StaticResource styleBoton}"
                Clicked="BtnExportar_OnClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
